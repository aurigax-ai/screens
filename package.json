{
  "name": "@aurigax-ai/screens",
  "version": "0.1.1",
  "description": "Alpha: isolated desktops for agents: a daemon, CLI and MCP server that run sandboxed Linux X screens",
  "license": "MIT",
  "type": "module",
  "bin": {
    "screens": "dist/cli.js"
  },
  "files": [
    "dist",
    "CONTRACT.md",
    "image.json"
  ],
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.10.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aurigax-ai/screens.git"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/derive-seccomp.mjs",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "pnpm run build && vitest run --project unit",
    "test:integration": "pnpm run build && vitest run --project integration",
    "prepack": "pnpm run build",
    "in-session": "pnpm -s run build && node test/tools/run-in-session.mjs",
    "check:pack": "scripts/check-pack.sh",
    "build:image": "scripts/build-image.sh",
    "test:mac": "vitest run --project mac"
  },
  "dependencies": {
    "@anthropic-ai/sandbox-runtime": "0.0.79",
    "@modelcontextprotocol/sdk": "1.32.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "22.20.5",
    "typescript": "7.0.2",
    "vitest": "5.0.4"
  }
}
